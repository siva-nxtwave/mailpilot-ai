# ==============================================================================
# MailPilot_AI - Monorepo Environment Variables Reference
# ==============================================================================
# Architecture:
# - Frontend: client/ -> Deploy on Vercel (https://mailpilot.karthikeyantech.in)
# - Backend:  server/ -> Deploy on Render (https://<render-backend>.onrender.com)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Render Backend Environment Variables (Root Directory: server)
# ------------------------------------------------------------------------------
PORT=5001
CLIENT_URL=https://mailpilot.karthikeyantech.in
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mailpilot
JWT_SECRET=mailpilot_super_secret_jwt_key_production_2026_change_me
JWT_EXPIRES_IN=7d
CREDENTIAL_ENCRYPTION_KEY=mailpilot_secure_encryption_key_32_bytes!

# Google OAuth (Authorized Redirect URI must be registered in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://<render-backend>.onrender.com/api/integrations/gmail/oauth/callback

# AI Engine API Keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
REDIS_URL=
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Vercel Frontend Environment Variables (Root Directory: client)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://<render-backend>.onrender.com
NEXT_PUBLIC_SOCKET_URL=https://<render-backend>.onrender.com
