# Server Port & Client URL
PORT=5001
CLIENT_URL=http://localhost:3000

# Database (Leave empty to automatically use built-in MongoMemoryServer in development)
MONGODB_URI=

# JWT Authentication
JWT_SECRET=mailpilot_super_secret_jwt_key_development_2026
JWT_EXPIRES_IN=7d

# AES-256 Token Encryption Key (32 bytes / passphrase)
CREDENTIAL_ENCRYPTION_KEY=mailpilot_secure_encryption_key_32_bytes!

# Google Cloud OAuth 2.0 Credentials (for Gmail integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/integrations/gmail/oauth/callback

# AI Provider 1: OpenRouter (Primary)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# AI Provider 2: Google Gemini (Secondary Fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Background Queue (Optional: Redis URL)
REDIS_URL=
