# ==============================================================================
# MailPilot_AI Server (Node.js/Express) - Environment Variables
# Deploy on: Render Web Service (Root Directory: server)
# Build Command: npm install
# Start Command: npm start
# ==============================================================================

# [Server Port & Client URL]
# Render automatically injects PORT. In local dev, defaults to 5001.
PORT=5001

# [CORS Allowed Frontend Origin]
# Local Development: http://localhost:3000
# Production (Render): https://mailpilot.karthikeyantech.in
CLIENT_URL=https://mailpilot.karthikeyantech.in

# [Database Connection]
# MongoDB Atlas Connection URI (e.g. mongodb+srv://<user>:<password>@cluster.mongodb.net/mailpilot)
# Leave empty in local dev to use built-in MongoMemoryServer
MONGODB_URI=

# [JWT Authentication Secret]
# Generate a strong random 64-character secret for production
JWT_SECRET=mailpilot_super_secret_jwt_key_production_2026_change_me
JWT_EXPIRES_IN=7d

# [AES-256-GCM Token Encryption Key]
# Required for encrypting Google OAuth refresh tokens securely at rest (32 characters / 256 bits)
CREDENTIAL_ENCRYPTION_KEY=mailpilot_secure_encryption_key_32_bytes!

# [Google Cloud OAuth 2.0 Credentials]
# Create OAuth 2.0 Web Client in Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local: http://localhost:5001/api/integrations/gmail/oauth/callback
# Production (Render): https://<render-backend>.onrender.com/api/integrations/gmail/oauth/callback
GOOGLE_REDIRECT_URI=https://<render-backend>.onrender.com/api/integrations/gmail/oauth/callback

# [AI Engine Provider 1: OpenRouter (Primary)]
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# [AI Engine Provider 2: Google Gemini (Secondary Fallback)]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# [Background Queues: Optional Redis Cache/Queue]
REDIS_URL=

# [Node Environment]
NODE_ENV=production
