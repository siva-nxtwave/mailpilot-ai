# ==============================================================================
# MailPilot_AI Client (Next.js) - Environment Variables
# Deploy on: Vercel (Root Directory: client)
# Production URL: https://mailpilot.karthikeyantech.in
# ==============================================================================

# [Required] Backend API Base URL
# Local Development: http://localhost:5001/api (or http://localhost:5001)
# Production (Vercel): Set to your Render backend service URL (e.g. https://<render-backend>.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# [Optional] Socket.IO Base URL (Defaults automatically to NEXT_PUBLIC_API_URL host if omitted)
# Local Development: http://localhost:5001
# Production (Vercel): https://<render-backend>.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001
